-- Seed one independent demo desk and return a machine-readable party map.
-- All assets and oracle marks are simulations; no external issuer is implied.
module Symbolon.Setup where

import DA.Date (Month (Jan), date)
import DA.Foldable (forA_)
import DA.Time
import Daml.Script
import Symbolon.DemoAsset
import Symbolon.Repo

data Desk = Desk with
  issuer : Party
  oracle : Party
  borrower : Party
  dealerA : Party
  dealerB : Party
  outsider : Party

setupDesk : Script Desk
setupDesk = do
  now <- getTime
  let epoch = time (date 1970 Jan 1) 0 0 0
      salt = show (convertRelTimeToMicroseconds (subTime now epoch))
      alloc n = allocateParty (n <> "-" <> salt)
  issuer <- alloc "issuer"
  oracle <- alloc "oracle"
  borrower <- alloc "borrower"
  dealerA <- alloc "dealer-a"
  dealerB <- alloc "dealer-b"
  outsider <- alloc "outsider"
  let desk = Desk with issuer; oracle; borrower; dealerA; dealerB; outsider
      readers = [borrower, dealerA, dealerB]
  forA_ [(borrower, "CETH", 400.0), (borrower, "TBILL", 30000.0),
         (borrower, "CBTC", 2.0), (borrower, "CUSD", 50000.0),
         (dealerA, "CUSD", 250000.0), (dealerB, "CUSD", 250000.0)] $ \(owner, instrument, amount) -> do
    _ <- submit issuer $ createCmd Holding with
      issuer; owner; instrument; amount; viewers = []; lockParties = []
    pure ()
  forA_ [("CETH", 100.0), ("TBILL", 1.0), ("CBTC", 64000.0)] $ \(instrument, price) -> do
    _ <- submit oracle $ createCmd PriceFeed with
      oracle; instrumentIssuer = issuer; instrument
      cashIssuer = issuer; cashInstrument = "CUSD"; price; asOf = now; readers
    pure ()
  debug "Symbolon demo desk seeded: simulated assets and simulated marks."
  pure desk

setup : Script Desk
setup = setupDesk
