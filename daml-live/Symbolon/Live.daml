-- Run these against a wall-clock sandbox. Unit/adversarial tests remain in
-- symbolon-test; this package depends on its DAR, avoiding duplicated sources.
module Symbolon.Live where

import DA.Time
import Daml.Script
import qualified Symbolon.Test.EndToEnd as Tests
import qualified Symbolon.Setup as Setup

liveLifecycle : Script ()
liveLifecycle = Tests.lifecycleWith $ \s -> sleep (seconds s)

liveHappyPath : Script ()
liveHappyPath = Tests.repoHappyPath

setupDesk : Script Setup.Desk
setupDesk = Setup.setupDesk
