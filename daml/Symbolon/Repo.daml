-- Private bilateral repo prototype. Trade terms belong to the counterparties;
-- the oracle publishes marks, and the demo issuer sees its asset movements.
-- Assets are trusted-issuer demo holdings, not real-world/CIP-56 assets.
module Symbolon.Repo where

import DA.Foldable (forA_)
import DA.Time
import Symbolon.DemoAsset

validTerms : Party -> Party -> Text -> Decimal -> Text -> Decimal -> Int -> Decimal -> Int -> Int -> Bool
validTerms borrower dealer collateralInstrument collateralAmount cashInstrument cashAmount termDays marginThresholdPct cureSeconds maxPriceAgeSeconds =
  borrower /= dealer && collateralInstrument /= "" && cashInstrument /= ""
  && collateralAmount > 0.0 && cashAmount > 0.0
  && termDays >= 1 && termDays <= 365
  && marginThresholdPct >= 1.0 && marginThresholdPct <= 2.0
  && cureSeconds >= 1 && cureSeconds <= 604800
  && maxPriceAgeSeconds >= 1 && maxPriceAgeSeconds <= 86400

validRate : Decimal -> Bool
validRate rate = rate >= 0.0 && rate <= 1.0

template PriceFeed
  with
    oracle : Party
    instrumentIssuer : Party
    instrument : Text
    cashIssuer : Party
    cashInstrument : Text
    price : Decimal -- units of the identified cash asset per collateral unit
    asOf : Time
    readers : [Party]
  where
    signatory oracle
    observer readers
    ensure price > 0.0 && instrument /= "" && cashInstrument /= ""

    choice SetPrice : ContractId PriceFeed
      with
        newPrice : Decimal
        at : Time
      controller oracle
      do
        now <- getTime
        assertMsg "price must be positive" (newPrice > 0.0)
        assertMsg "price timestamp must not be in the future" (at <= now)
        assertMsg "price timestamp must not move backwards" (at >= asOf)
        create this with price = newPrice, asOf = at

-- Active does not imply fresh: validate identity, denomination and timestamp.
checkedPrice : ContractId PriceFeed -> Party -> Party -> Text -> Party -> Text -> Int -> Update Decimal
checkedPrice feedCid oracle instrumentIssuer instrument cashIssuer cashInstrument maxPriceAgeSeconds = do
  feed <- fetch feedCid
  assertMsg "feed is not the agreed oracle/asset/cash denomination"
    (feed.oracle == oracle && feed.instrumentIssuer == instrumentIssuer
      && feed.instrument == instrument && feed.cashIssuer == cashIssuer
      && feed.cashInstrument == cashInstrument)
  now <- getTime
  assertMsg "price timestamp must not be in the future" (feed.asOf <= now)
  assertMsg "price is stale" (now <= addRelTime feed.asOf (seconds maxPriceAgeSeconds))
  assertMsg "price must be positive" (feed.price > 0.0)
  pure feed.price

exactAvailable : Holding -> Party -> Party -> Text -> Decimal -> Update ()
exactAvailable h owner issuer instrument amount =
  assertMsg "holding must be exact-sized, available, and match owner/issuer/instrument"
    (h.owner == owner && h.issuer == issuer && h.instrument == instrument
      && h.amount == amount && null h.lockParties)

exactReserved : Holding -> Party -> Party -> Text -> Decimal -> Party -> Update ()
exactReserved h owner issuer instrument amount lockParty =
  assertMsg "reservation must match owner/issuer/instrument/amount/lock"
    (h.owner == owner && h.issuer == issuer && h.instrument == instrument
      && h.amount == amount && h.lockParties == [lockParty])

data PositionStatus = Active | UnderCall Time deriving (Eq, Show)
data RepoOutcome = Repurchased | Defaulted | Liquidated deriving (Eq, Show)

requiredMarginValue : Decimal -> Decimal -> Decimal
requiredMarginValue cashAmount marginThresholdPct = cashAmount * marginThresholdPct

-- A factor below 1 means the collateral is worth less than the agreed margin.
healthFactor : Decimal -> Decimal -> Decimal -> Decimal -> Decimal
healthFactor collateralAmount price cashAmount marginThresholdPct =
  collateralAmount * price / requiredMarginValue cashAmount marginThresholdPct

hasRequiredMargin : Decimal -> Decimal -> Decimal -> Decimal -> Bool
hasRequiredMargin collateralAmount price cashAmount marginThresholdPct =
  collateralAmount * price >= requiredMarginValue cashAmount marginThresholdPct

isActionDeadlineReached : Time -> Time -> PositionStatus -> Bool
isActionDeadlineReached now maturity status = now >= maturity || case status of
  Active -> False
  UnderCall deadline -> now >= deadline

template QuoteRequest
  with
    borrower : Party
    dealer : Party
    oracle : Party
    collateralIssuer : Party
    collateralInstrument : Text
    collateralAmount : Decimal
    cashIssuer : Party
    cashInstrument : Text
    cashAmount : Decimal
    termDays : Int
    marginThresholdPct : Decimal
    cureSeconds : Int
    maxPriceAgeSeconds : Int
  where
    signatory borrower
    observer dealer
    ensure validTerms borrower dealer collateralInstrument collateralAmount cashInstrument cashAmount termDays marginThresholdPct cureSeconds maxPriceAgeSeconds

    choice SubmitQuote : ContractId RepoQuote
      with
        rate : Decimal
        validSeconds : Int
        cashCid : ContractId Holding
      controller dealer
      do
        assertMsg "annual rate must be between 0 and 1" (validRate rate)
        assertMsg "quote validity must be 1 to 86400 seconds"
          (validSeconds >= 1 && validSeconds <= 86400)
        cash <- fetch cashCid
        exactAvailable cash dealer cashIssuer cashInstrument cashAmount
        (reserved, _) <- exercise cashCid Reserve with
          to = dealer, qty = cashAmount, lockParty = borrower
        now <- getTime
        create RepoQuote with
          borrower; dealer; oracle; collateralIssuer
          collateralInstrument; collateralAmount; cashIssuer
          cashInstrument; cashAmount; termDays; marginThresholdPct
          cureSeconds; maxPriceAgeSeconds; rate
          cashCid = reserved
          validUntil = addRelTime now (seconds validSeconds)

    choice WithdrawRequest : ()
      controller borrower
      do pure ()

    choice PassRequest : ()
      controller dealer
      do pure ()

template RepoQuote
  with
    borrower : Party
    dealer : Party
    oracle : Party
    collateralIssuer : Party
    collateralInstrument : Text
    collateralAmount : Decimal
    cashIssuer : Party
    cashInstrument : Text
    cashAmount : Decimal
    termDays : Int
    marginThresholdPct : Decimal
    cureSeconds : Int
    maxPriceAgeSeconds : Int
    rate : Decimal
    cashCid : ContractId Holding
    validUntil : Time
  where
    signatory borrower, dealer
    ensure validTerms borrower dealer collateralInstrument collateralAmount cashInstrument cashAmount termDays marginThresholdPct cureSeconds maxPriceAgeSeconds && validRate rate

    choice AcceptQuote : ContractId RepoPosition
      with
        collateralCid : ContractId Holding
        feedCid : ContractId PriceFeed
      controller borrower
      do
        now <- getTime
        assertMsg "quote has expired" (now < validUntil)
        price <- checkedPrice feedCid oracle collateralIssuer collateralInstrument cashIssuer cashInstrument maxPriceAgeSeconds
        assertMsg "initial collateral does not meet margin"
          (hasRequiredMargin collateralAmount price cashAmount marginThresholdPct)
        coll <- fetch collateralCid
        exactAvailable coll borrower collateralIssuer collateralInstrument collateralAmount
        cash <- fetch cashCid
        exactReserved cash dealer cashIssuer cashInstrument cashAmount borrower
        (pledged, _) <- exercise collateralCid Reserve with
          to = dealer, qty = collateralAmount, lockParty = borrower
        _ <- exercise cashCid Transfer with
          to = borrower, qty = cashAmount, newViewers = []
        let interest = cashAmount * rate * intToDecimal termDays / 360.0
        create RepoPosition with
          borrower; dealer; oracle; collateralIssuer
          collateralInstrument; collateralAmount; cashIssuer
          cashInstrument; cashAmount
          repurchasePrice = cashAmount + interest
          rate; termDays; marginThresholdPct; cureSeconds; maxPriceAgeSeconds
          pledgedCids = [pledged]
          startTime = now
          maturity = addRelTime now (days termDays)
          status = Active

    choice RevokeQuote : ()
      controller dealer
      do
        cash <- fetch cashCid
        exactReserved cash dealer cashIssuer cashInstrument cashAmount borrower
        _ <- exercise cashCid Transfer with to = dealer, qty = cashAmount, newViewers = []
        pure ()

    choice RejectQuote : ()
      controller borrower
      do
        cash <- fetch cashCid
        exactReserved cash dealer cashIssuer cashInstrument cashAmount borrower
        _ <- exercise cashCid Transfer with to = dealer, qty = cashAmount, newViewers = []
        pure ()

template RepoPosition
  with
    borrower : Party
    dealer : Party
    oracle : Party
    collateralIssuer : Party
    collateralInstrument : Text
    collateralAmount : Decimal
    cashIssuer : Party
    cashInstrument : Text
    cashAmount : Decimal
    repurchasePrice : Decimal
    rate : Decimal
    termDays : Int
    marginThresholdPct : Decimal
    cureSeconds : Int
    maxPriceAgeSeconds : Int
    pledgedCids : [ContractId Holding]
    startTime : Time
    maturity : Time
    status : PositionStatus
  where
    signatory borrower, dealer
    ensure validTerms borrower dealer collateralInstrument collateralAmount cashInstrument cashAmount termDays marginThresholdPct cureSeconds maxPriceAgeSeconds
      && validRate rate && not (null pledgedCids)
      && repurchasePrice == cashAmount + cashAmount * rate * intToDecimal termDays / 360.0
      && maturity == addRelTime startTime (days termDays)

    -- Early repurchase pays the FULL fixed price; deadlines end the cure right.
    choice Repurchase : ContractId ClosedRepo
      with
        cashCid : ContractId Holding
      controller borrower
      do
        now <- getTime
        assertMsg "position is past its repayment/cure deadline" (not (isActionDeadlineReached now maturity status))
        cash <- fetch cashCid
        exactAvailable cash borrower cashIssuer cashInstrument repurchasePrice
        _ <- exercise cashCid Transfer with to = dealer, qty = repurchasePrice, newViewers = []
        releaseCollateral pledgedCids dealer collateralIssuer collateralInstrument collateralAmount borrower borrower
        create ClosedRepo with
          borrower; dealer; collateralIssuer; collateralInstrument; collateralAmount
          cashIssuer; cashInstrument; repurchasePrice; outcome = Repurchased; closedAt = now
          closeoutPrice = None; closeoutHealthFactor = None

    choice IssueMarginCall : ContractId RepoPosition
      with
        feedCid : ContractId PriceFeed
      controller dealer
      do
        now <- getTime
        assertMsg "position has matured" (now < maturity)
        assertMsg "already under margin call" (status == Active)
        price <- checkedPrice feedCid oracle collateralIssuer collateralInstrument cashIssuer cashInstrument maxPriceAgeSeconds
        assertMsg "position is healthy - margin call rejected"
          (not (hasRequiredMargin collateralAmount price cashAmount marginThresholdPct))
        create this with status = UnderCall (min maturity (addRelTime now (seconds cureSeconds)))

    -- A borrower can clear an open call if the agreed oracle mark has recovered.
    choice ResolveMarginCall : ContractId RepoPosition
      with
        feedCid : ContractId PriceFeed
      controller borrower
      do
        now <- getTime
        assertMsg "position has matured" (now < maturity)
        case status of
          UnderCall _ -> pure ()
          Active -> abort "no margin call to resolve"
        price <- checkedPrice feedCid oracle collateralIssuer collateralInstrument cashIssuer cashInstrument maxPriceAgeSeconds
        assertMsg "collateral remains below the agreed margin"
          (hasRequiredMargin collateralAmount price cashAmount marginThresholdPct)
        create this with status = Active

    choice TopUpCollateral : ContractId RepoPosition
      with
        extraCid : ContractId Holding
        extraQty : Decimal
        feedCid : ContractId PriceFeed
      controller borrower
      do
        now <- getTime
        assertMsg "position is past its repayment/cure deadline" (not (isActionDeadlineReached now maturity status))
        assertMsg "top-up amount must be positive" (extraQty > 0.0)
        price <- checkedPrice feedCid oracle collateralIssuer collateralInstrument cashIssuer cashInstrument maxPriceAgeSeconds
        extra <- fetch extraCid
        exactAvailable extra borrower collateralIssuer collateralInstrument extraQty
        let newAmount = collateralAmount + extraQty
        assertMsg "top-up does not restore the margin"
          (hasRequiredMargin newAmount price cashAmount marginThresholdPct)
        (sentCid, _) <- exercise extraCid Reserve with
          to = dealer, qty = extraQty, lockParty = borrower
        create this with collateralAmount = newAmount, pledgedCids = pledgedCids ++ [sentCid], status = Active

    -- Reserve only the exact substitute under the counterparty's lock.
    nonconsuming choice ProposeSubstitution : ContractId SubstitutionProposal
      with
        newIssuer : Party
        newInstrument : Text
        newQty : Decimal
        newHoldingCid : ContractId Holding
        newFeedCid : ContractId PriceFeed
      controller borrower
      do
        now <- getTime
        assertMsg "position is past its repayment/cure deadline" (not (isActionDeadlineReached now maturity status))
        assertMsg "substitution amount must be positive" (newQty > 0.0)
        price <- checkedPrice newFeedCid oracle newIssuer newInstrument cashIssuer cashInstrument maxPriceAgeSeconds
        assertMsg "substitute collateral is undervalued" (hasRequiredMargin newQty price cashAmount marginThresholdPct)
        newH <- fetch newHoldingCid
        exactAvailable newH borrower newIssuer newInstrument newQty
        (reserved, _) <- exercise newHoldingCid Reserve with
          to = borrower, qty = newQty, lockParty = dealer
        create SubstitutionProposal with
          borrower; dealer; posCid = self; newIssuer; newInstrument; newQty
          newHoldingCid = reserved; newFeedCid

    choice ExecuteSubstitution : ContractId RepoPosition
      with
        newIssuer : Party
        newInstrument : Text
        newQty : Decimal
        newHoldingCid : ContractId Holding
        newFeedCid : ContractId PriceFeed
      controller borrower, dealer
      do
        now <- getTime
        assertMsg "position is past its repayment/cure deadline" (not (isActionDeadlineReached now maturity status))
        assertMsg "substitution amount must be positive" (newQty > 0.0)
        price <- checkedPrice newFeedCid oracle newIssuer newInstrument cashIssuer cashInstrument maxPriceAgeSeconds
        assertMsg "substitute collateral is undervalued" (hasRequiredMargin newQty price cashAmount marginThresholdPct)
        newH <- fetch newHoldingCid
        exactReserved newH borrower newIssuer newInstrument newQty dealer
        (inCid, _) <- exercise newHoldingCid Reserve with to = dealer, qty = newQty, lockParty = borrower
        releaseCollateral pledgedCids dealer collateralIssuer collateralInstrument collateralAmount borrower borrower
        create this with collateralIssuer = newIssuer, collateralInstrument = newInstrument, collateralAmount = newQty, pledgedCids = [inCid], status = Active

    -- A failed margin cure needs a fresh mark that still proves HF < 1.
    -- The demo closeout gives the pledged collateral to the dealer; it does
    -- not model an auction, realized proceeds, or surplus accounting.
    choice Liquidate : ContractId ClosedRepo
      with
        feedCid : ContractId PriceFeed
      controller dealer
      do
        now <- getTime
        deadline <- case status of
          UnderCall d -> pure d
          Active -> abort "liquidation requires an open margin call"
        assertMsg "margin cure window is still open" (now >= deadline)
        mark <- fetch feedCid
        assertMsg "liquidation requires a mark published after the cure deadline" (mark.asOf >= deadline)
        price <- checkedPrice feedCid oracle collateralIssuer collateralInstrument cashIssuer cashInstrument maxPriceAgeSeconds
        assertMsg "position has recovered; liquidation rejected"
          (not (hasRequiredMargin collateralAmount price cashAmount marginThresholdPct))
        releaseCollateral pledgedCids dealer collateralIssuer collateralInstrument collateralAmount borrower dealer
        create ClosedRepo with
          borrower; dealer; collateralIssuer; collateralInstrument; collateralAmount
          cashIssuer; cashInstrument; repurchasePrice; outcome = Liquidated; closedAt = now
          closeoutPrice = Some price
          closeoutHealthFactor = Some (healthFactor collateralAmount price cashAmount marginThresholdPct)

    -- Missing the agreed maturity is a separate default trigger.
    choice DeclareDefault : ContractId ClosedRepo
      controller dealer
      do
        now <- getTime
        assertMsg "repo has not matured" (now >= maturity)
        releaseCollateral pledgedCids dealer collateralIssuer collateralInstrument collateralAmount borrower dealer
        create ClosedRepo with
          borrower; dealer; collateralIssuer; collateralInstrument; collateralAmount
          cashIssuer; cashInstrument; repurchasePrice; outcome = Defaulted; closedAt = now
          closeoutPrice = None; closeoutHealthFactor = None

releaseCollateral : [ContractId Holding] -> Party -> Party -> Text -> Decimal -> Party -> Party -> Update ()
releaseCollateral cids owner issuer instrument amount lockParty recipient = do
  holdings <- mapA fetch cids
  assertMsg "pledged collateral total mismatch" (sum (map (.amount) holdings) == amount)
  forA_ (zip cids holdings) $ \(cid, h) -> do
    exactReserved h owner issuer instrument h.amount lockParty
    _ <- exercise cid Transfer with to = recipient, qty = h.amount, newViewers = []
    pure ()

template SubstitutionProposal
  with
    borrower : Party
    dealer : Party
    posCid : ContractId RepoPosition
    newIssuer : Party
    newInstrument : Text
    newQty : Decimal
    newHoldingCid : ContractId Holding
    newFeedCid : ContractId PriceFeed
  where
    signatory borrower, dealer
    ensure borrower /= dealer && newInstrument /= "" && newQty > 0.0

    choice AcceptSubstitution : ContractId RepoPosition
      controller dealer
      do
        pos <- fetch posCid
        assertMsg "proposal counterparties do not match position" (pos.borrower == borrower && pos.dealer == dealer)
        exercise posCid ExecuteSubstitution with newIssuer; newInstrument; newQty; newHoldingCid; newFeedCid

    choice RejectSubstitution : ()
      controller dealer
      do
        h <- fetch newHoldingCid
        exactReserved h borrower newIssuer newInstrument newQty dealer
        _ <- exercise newHoldingCid Transfer with to = borrower, qty = newQty, newViewers = []
        pure ()

    choice WithdrawSubstitution : ()
      controller borrower
      do
        h <- fetch newHoldingCid
        exactReserved h borrower newIssuer newInstrument newQty dealer
        _ <- exercise newHoldingCid Transfer with to = borrower, qty = newQty, newViewers = []
        pure ()

template ClosedRepo
  with
    borrower : Party
    dealer : Party
    collateralIssuer : Party
    collateralInstrument : Text
    collateralAmount : Decimal
    cashIssuer : Party
    cashInstrument : Text
    repurchasePrice : Decimal
    outcome : RepoOutcome
    closedAt : Time
    closeoutPrice : Optional Decimal
    closeoutHealthFactor : Optional Decimal
  where
    signatory borrower, dealer
    ensure borrower /= dealer && collateralAmount > 0.0 && repurchasePrice > 0.0
