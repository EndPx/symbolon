-- Demonstration assets, NOT CIP-56 / Splice tokens.
-- The issuer is trusted to mint and archive its assets. A lock party must
-- authorize every owner-controlled mutation, preventing unilateral spending
-- of quote funding or repo collateral. This is not a production custody model.
module Symbolon.DemoAsset where

template Holding
  with
    issuer : Party
    owner : Party
    instrument : Text
    amount : Decimal
    viewers : [Party]
    lockParties : [Party]
  where
    signatory issuer
    observer owner, viewers, lockParties
    ensure amount > 0.0 && instrument /= "" && all (/= owner) lockParties

    -- Split excess in an OWNER-ONLY transaction before passing an exact-sized
    -- holding into a bilateral choice. This keeps the original balance and
    -- change out of the counterparty's transaction view.
    choice Transfer : (ContractId Holding, Optional (ContractId Holding))
      with
        to : Party
        qty : Decimal
        newViewers : [Party]
      controller owner, lockParties
      do
        assertMsg "transfer amount must be positive" (qty > 0.0)
        assertMsg "insufficient holding" (qty <= amount)
        sent <- create this with owner = to, amount = qty, viewers = newViewers, lockParties = []
        change <- if qty < amount
          then Some <$> create this with amount = amount - qty, viewers = if null lockParties then [] else viewers
          else pure None
        pure (sent, change)

    -- Existing locks authorize replacement; change keeps existing locks.
    choice Reserve : (ContractId Holding, Optional (ContractId Holding))
      with
        to : Party
        qty : Decimal
        lockParty : Party
      controller owner, lockParties
      do
        assertMsg "reservation amount must be positive" (qty > 0.0)
        assertMsg "insufficient holding" (qty <= amount)
        assertMsg "lock party must differ from owner" (lockParty /= to)
        sent <- create this with owner = to, amount = qty, viewers = [], lockParties = [lockParty]
        change <- if qty < amount
          then Some <$> create this with amount = amount - qty, viewers = if null lockParties then [] else viewers
          else pure None
        pure (sent, change)

    choice SetViewers : ContractId Holding
      with
        newViewers : [Party]
      controller owner, lockParties
      do create this with viewers = newViewers

    choice Merge : ContractId Holding
      with
        otherCid : ContractId Holding
      controller owner, lockParties
      do
        assertMsg "cannot merge a holding with itself" (otherCid /= self)
        assertMsg "reserved holdings cannot be merged" (null lockParties)
        other <- fetch otherCid
        assertMsg "reserved holdings cannot be merged" (null other.lockParties)
        assertMsg "holdings must share issuer, owner and instrument"
          (other.issuer == issuer && other.owner == owner
            && other.instrument == instrument)
        archive otherCid
        create this with amount = amount + other.amount, viewers = []
